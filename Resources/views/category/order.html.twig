{% extends '@AropixelAdmin/List/order.html.twig' %}


{% block meta_title %}Catégories - Réorganiser les catégories{% endblock %}
{% block header_title %}Réorganiser les catégories{% endblock %}
{% block header_breadcrumb %}
    <ul class="breadcrumb breadcrumb-caret position-right">
        <li class="breadcrumb-item"><a href="{{ url('_admin') }}">Accueil</a></li>
        <li class="breadcrumb-item">Blog</li>
        <li class="breadcrumb-item"><a href="{{ url('aropixel_blog_category_index') }}">Catégories</a></li>
        <li class="breadcrumb-item active">Réorganiser les catégories</li>
    </ul>
{% endblock %}


{% block paneltitle %}Réorganiser les catégories{% endblock %}


{% block panelbody %}

    <table class="table sortable" data-path="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
        <thead>
        <tr>
            <th class="position" width="40">&nbsp;</th>
            <th style="width: 50px">Pos.</th>
            <th>Titre</th>
            <th style="width:200px">Date</th>
        </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr id="entity_{{ category.id }}">
                <td class="position"><i class="fas fa-arrows-alt"></i></td>
                <td class="position numero" style="width:35px;">{{ category.position + 1 }}.</td>
                <td>{{ category.name }}</td>
                <td>{{ category.createdAt|datetime('dd/MM/Y') }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
