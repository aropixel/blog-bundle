{% extends '@AropixelAdmin/Form/base.html.twig' %}

{% block meta_title %}{% trans %}Categories{% endtrans %} - {% if category and category.id %}{% trans %}Edit{% endtrans %}{% else %}{% trans %}Add{% endtrans %}{% endif %} {% trans %}a category{% endtrans %}{% endblock %}
{% block header_title %}{% trans %}Categories{% endtrans %}{% endblock %}

{% block header_breadcrumb %}
    <ul class="breadcrumb breadcrumb-caret position-right">
        <li class="breadcrumb-item"><a href="{{ url('_admin') }}">{% trans %}Home{% endtrans %}</a></li>
        <li class="breadcrumb-item">Blog</li>
        <li class="breadcrumb-item"><a href="{{ url('aropixel_blog_category_index') }}">{% trans %}Categories{% endtrans %}</a></li>
        {% if category and category.id %}
            <li class="breadcrumb-item">{% trans %}Edit{% endtrans %}</li>
        {% else %}
            <li class="breadcrumb-item active">{% trans %}Add{% endtrans %}</li>
        {% endif %}
    </ul>
{% endblock %}


{% block tabbable %}
    <li class="nav-item"><a href="#panel-tab1" data-bs-toggle="pill" class="nav-link active"><span> {% trans %}Content{% endtrans %}</span></a></li>
{% endblock %}


{% block mainPanel %}

    <div class="tab-pane active" id="panel-tab1">

        <div class="card card-centered-large">

            <div class="card-body">

                {{ form_row(form.name) }}

            </div>

        </div>

    </div>

{% endblock %}
